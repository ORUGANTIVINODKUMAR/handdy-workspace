PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/employee_attendance
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
APP_TIMEZONE=Asia/Kolkata
# Browser origins only; the backend also permits Electron's local-file origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Optional comma-separated DNS resolvers for MongoDB SRV lookups.
MONGODB_DNS_SERVERS=

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:5173

# Optional SMTP settings for sending password-reset emails. When left blank,
# the reset link is logged to the server console instead (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Used only by: npm run create:idle-exempt
EXEMPT_EMPLOYEE_EMAIL=
EXEMPT_EMPLOYEE_ID=
EXEMPT_EMPLOYEE_NAME=
EXEMPT_EMPLOYEE_PASSWORD=
EXEMPT_EMPLOYEE_TEAM_ID=
