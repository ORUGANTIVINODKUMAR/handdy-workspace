{
  "name": "handdy-desktop-app",
  "version": "1.2.1",
  "description": "Employee Time & Attendance System Desktop App",
  "main": "main.js",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js",
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.handdy.timetracker",
    "productName": "CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "api-config.js",
      "idle-policy-defaults.json",
      "renderer.js",
      "index.html",
      "dashboard.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CRM-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRM"
    }
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.0"
  }
}
